{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bonuspunkt",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "BONUS", "class_name": "BonusDB" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BonusDB"] }]
}
